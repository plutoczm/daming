# Copy to .env and fill locally. Never commit .env.
DEEPSEEK_API_KEY=

# Optional real executor paths for local probes
DAMING_CODEX_EXE=
# Set to 1 to ignore ~/.codex/config.toml and use the official Codex auth/backend.
DAMING_CODEX_OFFICIAL=0
DAMING_CODEX_MODEL=gpt-6.1-sol
DAMING_DSH_EXE=D:/dsh/DeepSeek Harness.exe
DAMING_DSH_ENTRY=D:/dsh/resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js

# Optional: explicitly choose a pre-existing managed Magpie instance (otherwise use pnpm magpie:profile)
DAMING_MAGPIE_DATA_DIR=

# Optional live Lulu status
DAMING_LULU_BASE_URL=
DAMING_LULU_SESSION=

# Optional Feishu self-built app for S10 long-connection acceptance.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_OPEN_ID=

# Experimental two-agent project-copy preview. Default OFF. NO direct writes to the original project.
# Requires real Codex/DSH CLI configuration, current verified DeepSeek pricing and manual approval.
# Read-only CLI flags are NOT an OS sandbox; do not enable with sensitive source files.
DAMING_ENABLE_PROJECT_AGENTS=0
DAMING_PROJECT_SOURCE_ROOT=

# Safety gate: setting DAMING_ENABLE_PROJECT_AGENTS=1 is NOT sufficient to run
# real Codex/DSH model processes. Those CLI runners remain outside the
# tenant Docker security boundary, so Host refuses the project preview.

# Explicit opt-in for a ONE-SHOT, no-tool, text-only paid model egress.
# DEFAULT OFF: do not enable without accepting a soft (NOT guaranteed) cash
# ceiling. Requires owner MFA, exact tenant BYOA key, budget policy, fresh
# Docker isolation proof, immutable prepared request and separate send consent.
# Every attempted paid send remains CASH-UNKNOWN and blocks new sends until
# independently reconciled; this is NOT the Magpie multi-Agent auto route.
DAMING_ENABLE_PAID_EGRESS=0

# Optional: reuse an EXISTING Magpie desktop gateway on this same Windows host.
# No Magpie provider/Agent accounts, route groups or credentials are imported.
# DAMING_MAGPIE_EXISTING_GATEWAY_PORT=3457
# Provide DAMING_MAGPIE_EXISTING_GATEWAY_KEY in the local process environment
# from your own secret manager. Never commit an actual gateway key.
# When omitted, Daming retains its existing managed built-in gateway (damingd) mode.
